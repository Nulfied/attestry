htmlcov/

# Attestry workspaces created while trying things out.
# Note: a real project's .attestry directory SHOULD be committed -- the ledger,
# baselines, trust store and consent grants are the point. Only private keys,
# the package cache and raw run logs are machine-local, and .attestry carries
# its own .gitignore for those.
/.attestry/

